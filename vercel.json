{
  "rewrites": [
    {
      "source": "/admin",
      "destination": "/admin/index.html"
    },
    {
      "source": "/admin/(.*)",
      "destination": "/admin/index.html"
    },
    {
      "source": "/lessons",
      "destination": "/index.html"
    },
    {
      "source": "/cours",
      "destination": "/index.html"
    },
    {
      "source": "/((?!admin|pdf).*)/?",
      "destination": "/index.html"
    }
  ]
}
